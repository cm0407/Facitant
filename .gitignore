# Student rosters are protected by FERPA and this repo is public.
# Ignore every roster-type file so a real class list can't be committed by
# accident...
*.csv
*.tsv
*.txt
*.xls
*.xlsx
*.doc
*.docx
# ...except the made-up sample roster used for testing
!samples/*.csv

# Same as the portfolio
.env
.env.local
node_modules/
dist/
*.log
.DS_Store
